{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/search.php", "dest": "/api/search.php" },
    { "src": "/api.php", "dest": "/api/api.php" },
    { "src": "/image_proxy.php", "dest": "/api/image_proxy.php" },
    { "src": "/settings.php", "dest": "/api/settings.php" },
    { "src": "/instances.php", "dest": "/api/instances.php" },
    { "src": "/donate.php", "dest": "/api/donate.php" }
  ]
}
